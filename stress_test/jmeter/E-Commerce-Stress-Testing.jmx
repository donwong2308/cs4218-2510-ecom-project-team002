          <elementProp name="THINK_TIME_MAX" elementType="Argument">
            <stringProp name="Argument.name">THINK_TIME_MAX</stringProp>
            <stringProp name="Argument.value">1000</stringProp>
            <stringProp name="Argument.desc">Max think time (ms) - 0-1s for stress</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="TIMEOUT" elementType="Argument">
            <stringProp name="Argument.name">TIMEOUT</stringProp>
            <stringProp name="Argument.value">30000</stringProp>
            <stringProp name="Argument.desc">Request timeout (ms) - 30s</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
